# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/workflow_builder

# Better Auth
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# AI (OpenRouter by default)
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=your-openrouter-api-key
# Legacy alias used by integrations UI
AI_GATEWAY_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_NAME=Graphitti Workflows
AI_WORKFLOW_MODEL=openai/gpt-4o-mini

# Encrypt integration secrets at rest (openssl rand -hex 32)
INTEGRATION_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-hex-32

# Optional: set AI_PROVIDER=vercel to use Vercel AI Gateway instead
# AI_PROVIDER=vercel
